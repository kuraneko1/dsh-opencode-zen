{
  "name": "dsh-opencode-zen",
  "version": "0.2.4",
  "description": "OpenCode Zen free models as a native DSH/RDSH provider plugin with an isolated local relay",
  "type": "module",
  "license": "MIT",
  "author": "kuraneko1",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kuraneko1/dsh-opencode-zen.git"
  },
  "homepage": "https://github.com/kuraneko1/dsh-opencode-zen#readme",
  "bugs": {
    "url": "https://github.com/kuraneko1/dsh-opencode-zen/issues"
  },
  "main": "./index.mjs",
  "exports": {
    ".": "./index.mjs",
    "./opencode-plugin": "./opencode-plugin.mjs",
    "./server": "./opencode-plugin.mjs",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "bin": {
    "dsh-opencode-zen-proxy": "./supervisor.mjs",
    "dsh-opencode-zen-setup": "./setup.mjs"
  },
  "files": [
    "index.mjs",
    "server.mjs",
    "supervisor.mjs",
    "runtime-path.mjs",
    "zen-limits.mjs",
    "opencode-bridge.mjs",
    "opencode-plugin.mjs",
    "setup.mjs",
    "cordis.patch.yml",
    "README.md",
    "LICENSE",
    "SECURITY.md",
    "CHANGELOG.md",
    "AUDIT.md",
    "*.test.mjs",
    "bridge-smoke.mjs",
    "rdsh-smoke.mjs",
    "bench-context.mjs",
    "locale/*.json",
    "icon.svg",
    "README.en.md",
    "install.sh"
  ],
  "engines": {
    "node": ">=22.19.0",
    "dsh": "^0.2.0-rc.2"
  },
  "os": [
    "linux"
  ],
  "keywords": [
    "dsh",
    "rdsh",
    "opencode",
    "zen",
    "llm",
    "plugin"
  ],
  "dsh": {
    "manifestVersion": 1,
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.0.4",
    "@deepseek-ai/dsh": "^0.2.0-rc.2",
    "@deepseek-ai/dsh-credentials": "^0.2.0-rc.2",
    "@deepseek-ai/dsh-llm": "^0.2.0-rc.2",
    "@deepseek-ai/dsh-llm-pi-ai": "^0.2.0-rc.2",
    "@earendil-works/pi-ai": "^0.87.1"
  },
  "dependencies": {
    "@deepseek-ai/dsh-atomic-write": "^0.2.0-rc.2",
    "@deepseek-ai/schemastery": "~3.18.4",
    "yaml": "^2.9.1"
  },
  "scripts": {
    "test": "node --test *.test.mjs",
    "start": "node supervisor.mjs run",
    "status": "node supervisor.mjs status",
    "setup": "node setup.mjs",
    "test:live": "node bridge-smoke.mjs && node rdsh-smoke.mjs",
    "prepack": "node --test *.test.mjs"
  },
  "icon": "./icon.svg",
  "devDependencies": {
    "@deepseek-ai/dsh": "^0.2.0-rc.2",
    "@deepseek-ai/dsh-app-boot": "^0.2.0-rc.2"
  }
}
