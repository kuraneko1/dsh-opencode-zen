# Example for the standard web profile. Adjust PATH/ExecStart for your installation.
[Unit]
Description=OpenCode Zen free-model relay for DSH/RDSH
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
Restart=on-failure
RestartSec=3
KillMode=control-group
UMask=0077
NoNewPrivileges=yes
PrivateTmp=yes
Environment="PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin"
ExecStart=%h/.dsh/profiles/web/node_modules/.bin/dsh-opencode-zen-proxy run
TimeoutStartSec=180
TimeoutStopSec=60

[Install]
WantedBy=default.target
